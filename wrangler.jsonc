// Publication de l'appli Tétée sur Cloudflare (Workers, fichiers statiques).
// Seul le dossier « _tetee » est mis en ligne ; l'appli prénoms reste sur GitHub Pages.
// Les en-têtes de sécurité sont dans _tetee/_headers.
// Le dossier commence par « _ » : GitHub Pages ne le publie pas (l'appli n'existe qu'ici).
{
  "name": "tetee",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./_tetee"
  }
}
